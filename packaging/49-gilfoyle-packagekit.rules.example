// Example polkit rule for gilfoyle's package operations.
//
// Generate the real one from your configuration and install it with:
//
//   gilfoyle packagekit polkit-rule | sudo tee /etc/polkit-1/rules.d/49-gilfoyle-packagekit.rules > /dev/null
//
// It grants the `gilfoyle` user only the operations listed in [packagekit] allow
// (here: refresh and upgrade), and explicitly refuses installing, reinstalling,
// downgrading or removing packages, trusting new signing keys, and upgrading the
// whole distribution. Keep the allowed list in sync with [packagekit] allow.
polkit.addRule(function(action, subject) {
    if (subject.user != "gilfoyle") return polkit.Result.NOT_HANDLED;
    var denied = [
        "org.freedesktop.packagekit.package-install",
        "org.freedesktop.packagekit.package-install-untrusted",
        "org.freedesktop.packagekit.package-reinstall",
        "org.freedesktop.packagekit.package-downgrade",
        "org.freedesktop.packagekit.package-remove",
        "org.freedesktop.packagekit.upgrade-system",
        "org.freedesktop.packagekit.system-trust-signing-key"
    ];
    if (denied.indexOf(action.id) !== -1) return polkit.Result.NO;
    var allowed = [
        "org.freedesktop.packagekit.system-sources-refresh",
        "org.freedesktop.packagekit.system-update"
    ];
    if (allowed.indexOf(action.id) !== -1) return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
