---
interface Props {
  id: string;
  index: string;
  kicker: string;
  title: string;
  lead?: string;
}
const { id, index, kicker, title, lead } = Astro.props;
---

<section
  id={id}
  class="relative mx-auto w-full max-w-6xl px-6 py-20 sm:py-28"
>
  <div data-reveal class="mb-12 max-w-3xl">
    <div
      class="mb-4 flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faint"
    >
      <span class="text-blood">[{index}]</span>
      <span>{kicker}</span>
      <span class="h-px flex-1 bg-line"></span>
    </div>
    <h2
      class="text-balance text-3xl font-semibold leading-[1.15] tracking-tight text-fg sm:text-4xl"
    >
      {title}
    </h2>
    {
      lead && (
        <p class="mt-5 max-w-2xl text-[15px] leading-relaxed text-muted">
          {lead}
        </p>
      )
    }
  </div>
  <slot />
</section>
